# 服务端配置。真实值放 .env，不要提交。

PORT=8080
# 允许访问的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,https://flashgenerate-ai.vercel.app

# Postgres。Neon 的连接串形如 postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# 会话签名用的盐，随便一串长随机值，换掉它等于让所有人重新登录
SESSION_SECRET=

# 对象存储，S3 兼容（Cloudflare R2 / 阿里云 OSS / MinIO 都行）
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 下发给浏览器的签名地址有效期，秒
S3_SIGNED_URL_TTL=900

# 首次启动创建的管理员账号
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
